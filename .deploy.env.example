# Local deploy config (gitignored). Copy from .deploy.env.example
#
# GitHub — current repo (origin)
GITHUB_REMOTE=origin
GITHUB_URL=https://github.com/Furowu/brokr.git
#
# Gitee — mirror (push after authenticating to Gitee)
GITEE_REMOTE=gitee
GITEE_URL=https://gitee.com/furowu/brokr.git
GITEE_BRANCH=main
#
# Optional SSH remote:
# GITEE_URL=git@gitee.com:furowu/brokr.git
#
# DEPLOY_ALLOW_DIRTY=1
#
# Homebrew tap (separate repo: github.com/Furowu/homebrew-brokr)
# HOMEBREW_TAP_REMOTE=git@github.com:Furowu/homebrew-brokr.git
# HOMEBREW_TAP_DIR=../homebrew-brokr
