# Local deploy config (gitignored). Copy from .deploy.env.example
#
# GitHub — current repo (origin)
GITHUB_REMOTE=origin
GITHUB_URL=https://github.com/Furowu/brokre.git
#
# Gitee — mirror (push after authenticating to Gitee)
GITEE_REMOTE=gitee
GITEE_URL=https://gitee.com/furowu/brokre.git
GITEE_BRANCH=main
#
# Optional SSH remote:
# GITEE_URL=git@gitee.com:furowu/brokre.git
#
# DEPLOY_ALLOW_DIRTY=1
#
# Release binaries: push tag via ./d github or ./d release — GitHub Actions builds all platforms
# (.github/workflows/release.yml). Local ./d build is native-only for development.
#
# Homebrew tap (separate repo: github.com/Furowu/homebrew-brokre)
# HOMEBREW_TAP_REMOTE=https://github.com/Furowu/homebrew-brokre.git
# HOMEBREW_TAP_DIR=../homebrew-brokre
